<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- Product & Company Information -->
    <Company>FlowDevs LLC</Company>
    <Authors>FlowDevs</Authors>
    <Product>FlowAD</Product>
    <Description>Ultra-lightweight Active Directory health, GPO deconfliction, and DNS diagnostic engine.</Description>
    <Copyright>Copyright © FlowDevs LLC 2026</Copyright>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    
    <!-- Publishing & Trimming optimizations -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
